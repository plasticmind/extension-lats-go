{
  "manifest_version": 3,
  "name": "LATS Go!",
  "version": "1.3.0",
  "description": "Makes the NY State LATS timesheet faster: fill your schedule, leave, and location in one step, and finish TDS with less math.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "*://*.lats.ny.gov/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.lats.ny.gov/Default*"
      ],
      "css": [
        "styles/nysds-tokens.css",
        "styles/default.css"
      ],
      "js": [
        "scripts/default.js"
      ]
    },
    {
      "matches": [
        "*://*.lats.ny.gov/Time*"
      ],
      "css": [
        "styles/nysds-tokens.css",
        "styles/ui.css",
        "styles/content.css"
      ],
      "js": [
        "scripts/shared/utils.js",
        "scripts/lats-restyle.js",
        "scripts/content.js"
      ]
    },
    {
      "matches": [
        "*://*.lats.ny.gov/Time*"
      ],
      "js": [
        "scripts/page-bridge.js"
      ],
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.lats.ny.gov/error.aspx*"
      ],
      "js": [
        "scripts/error.js"
      ],
      "css": [
        "styles/nysds-tokens.css",
        "styles/error.css"
      ]
    }
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LATS Go!",
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "options_page": "options.html"
}
